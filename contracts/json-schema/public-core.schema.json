{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quaestor.biz/contracts/pub-lib-core/v1/public-core.schema.json",
  "$comment": "Human-authored JSON Schema authority. It is a peer of contracts/typespec/main.tsp; neither authority is generated from the other.",
  "title": "Quaestor public core v1",
  "$defs": {
    "ClientPlatform": {
      "type": "string",
      "description": "Untrusted-device runtime family.",
      "enum": ["browser", "desktop", "ios", "android"]
    },
    "ClientInfo": {
      "type": "object",
      "description": "Bounded metadata supplied by an untrusted client installation.",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "$ref": "#/$defs/ClientPlatform"
        },
        "appVersion": {
          "type": "string",
          "description": "Printable application version label.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[!-~]+$"
        },
        "locale": {
          "type": "string",
          "description": "Optional bounded BCP-47-shaped locale hint.",
          "minLength": 2,
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "installId": {
          "type": "string",
          "description": "Pseudonymous per-installation identifier; never a person or organization identifier.",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": ["platform", "appVersion", "installId"]
    },
    "IdempotencyKey": {
      "type": "object",
      "description": "Client-minted retry identity. It conveys no authorization or permission.",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "mintedAtMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Unix epoch milliseconds within the exactly portable JSON integer range."
        }
      },
      "required": ["key", "mintedAtMs"]
    }
  }
}
